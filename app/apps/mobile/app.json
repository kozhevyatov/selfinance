{
  "expo": {
    "name": "Selfinance",
    "slug": "selfinance",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "selfinance",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F3F5",
    "ios": {
      "bundleIdentifier": "ru.nskarl.selfinance",
      "buildNumber": "3",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Selfinance подключается к вашему серверу в домашней сети.",
        "NSFaceIDUsageDescription": "Selfinance использует Face ID для входа в приложение."
      }
    },
    "android": {
      "package": "ru.nskarl.selfinance",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4338CA"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F2F3F5",
          "dark": {
            "backgroundColor": "#0F1115"
          }
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Selfinance использует Face ID для входа в приложение."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4338CA"
        }
      ],
      "expo-quick-actions",
      "@react-native-community/datetimepicker"
    ],
    "owner": "nskarl",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "1d95df63-3c84-4f11-b649-618cee73d6ce"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/1d95df63-3c84-4f11-b649-618cee73d6ce"
    }
  }
}
