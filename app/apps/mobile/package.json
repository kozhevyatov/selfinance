{
  "name": "selfinance-mobile",
  "version": "1.2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit -p .",
    "build:apk": "npx eas-cli@latest build -p android --profile production",
    "build:ios": "npx eas-cli@latest build -p ios --profile production",
    "build:ios:preview": "npx eas-cli@latest build -p ios --profile preview",
    "submit:ios": "npx eas-cli@latest submit -p ios --latest",
    "update": "npx eas-cli@latest update --channel production --environment production"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-quick-actions": "^6.0.2",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "*",
    "expo-updates": "~58.0.22",
    "lucide-react-native": "*",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "*",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/require-utils": "58.0.6"
  }
}
